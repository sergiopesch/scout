# Place the OpenAI key here only for the one-time `make configure-secrets`
# migration. The command moves it to device-local Keychain and removes this line
# from `.env.local`. Never embed this value in Scout.app.
OPENAI_API_KEY=

# Optional non-secret development overrides.
SCOUT_GATEWAY_HOST=127.0.0.1
SCOUT_GATEWAY_PORT=0
SCOUT_CONTEXT_PACK_DIR=Gateway/context-packs
# OPENAI_VISION_MODEL defaults to OPENAI_CLAIMS_MODEL when omitted.
